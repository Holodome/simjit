{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Python Dev Extension",
      "binaryDir": "${sourceParentDir}/build/python-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIMJIT_ENABLE_LTO": "ON",
        "SIMJIT_PYTHON_PACKAGE_DIR": "${sourceParentDir}/build/python-dev/simjit"
      }
    },
    {
      "name": "debug",
      "displayName": "Python Debug Extension",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
